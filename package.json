{
	"name": "dunes-ledger",
	"version": "0.0.0",
	"private": true,
	"description": "A farming journal for Path of Exile map sessions: session net, typical map, and the drop behind the best map.",
	"license": "MIT",
	"author": "Mina Rotari",
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#samples/*": "./samples/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"serve": "node scripts/serve.mjs build --port 4173",
		"demo": "vite build && node scripts/serve.mjs build --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker/tsconfig.json",
		"test": "vitest run",
		"test:e2e": "vite build && playwright test",
		"icons": "node scripts/make-icons.mjs"
	},
	"dependencies": {
		"idb": "8.0.4"
	},
	"devDependencies": {
		"@playwright/test": "1.65.1",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.4.1",
		"@sveltejs/vite-plugin-svelte": "7.3.2",
		"@types/node": "24.19.4",
		"fake-indexeddb": "6.2.8",
		"fflate": "0.8.3",
		"sharp": "0.35.5",
		"svelte": "5.59.2",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"vite": "8.4.0",
		"vitest": "5.1.2"
	}
}
